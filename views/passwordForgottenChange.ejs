<% var title =   "Passwort vergessen" %>

<!DOCTYPE html>
<html>
  <%- include('./modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('./modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/user/account`)"})%>
      <div class="spacing13"></div>
      <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
        <div class="titleH4 info">

        </div>
    </div>
    <div class="spacing5"></div>
        <form id="form">
            <input type="password" id="password" required name="newPassword"
                  onchange="$(this).css('border', '0.5px solid black');Check();"
                  oninvalid=" $(this).css('border', '2px solid red');" placeholder="Neus Passwort" class="standardInput">
                  <div class="spacing5 first" style="display: none;"></div>
    
                  <div class="errorMessage redInnerShadowNoOffset message first" style="display: none;">
                    Dein Passwort sollte folgende Kriterien befolgen
                    <list>
                        <li>Es sollte mindestens 8 Zeichen lang sein.</li>
                        <li>Es sollte mindestens ein Grossbuchstabe beinhalten.</li>
                        <li>Es sollte mindestens ein Kleinbuchstabe beinhalten.</li>
                        <li>Es sollte mindestens eine Zahl beinhalten.</li>
                        <li>Es sollte mindestens ein Sonderzeichen beinhalten.</li>
                    </list>
                      </div>
                <div class="spacing5"></div>
                <input type="password" id="passwordCheck" required name="passwordCheck"
                  onchange="$(this).css('border', '0.5px solid black');matchCheck();"
                  oninvalid=" $(this).css('border', '2px solid red');" placeholder="Neus Passwort wiederholen" class="standardInput">
                  <div class="spacing5 second" style="display: none;"></div>

                <div class="errorMessage redInnerShadowNoOffset message second" style="display: none;">
                  Deine Passwörter stimmen nicht überein.
                </div>
    <div class="spacing5"></div>
    <input type="submit" class="submitButton button submit" value="Passwort festlegen">
</form>
    </div>
    <%- include('./modules/footer.ejs')%>

  </body>
</html>


<script>
     function Check(){
            var test = new RegExp('(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9])(?=.{8,})')
           if(test.test($('#password').val())){
            $('.first').hide()
            $('#password').css('border', '2px solid green')
            return true;
           }else{
            $('.first').show()
            $('#password').css('border', '2px solid red')
            return false;
           }
        }
        function matchCheck(){
            var test = new RegExp('(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9])(?=.{8,})')
           if($('#password').val() == $('#passwordCheck').val()){
            $('.second').hide()
            $('#passwordCheck').css('border', '2px solid green')
            $('#password').css('border', '2px solid green')
            return true;
           }else{
            $('.second').show()
            $('#password').css('border', '2px solid red')
            $('#passwordCheck').css('border', '2px solid red')
            return false;
           }
        }
    $("form").submit(function(e) {
       e.preventDefault();
       try {
        if(!matchCheck() || !Check()){
        $('.firstForm').show();
                          $('.firstForm').css("opacity", "1");
                          $('.firstForm .submit, .submitHide, .secondForm .errorHide').hide()
        return
      };
           $.ajax({
               url: '/passwordForgottenUpdate/',
               type: 'POST',
               cache: false,
               data:  {
                "password": $('#password').val(),
                "passwordCheck": $('#passwordCheck').val(),
                "token": "<%=token%>"
               },
               xhrFields: {
                    withCredentials: true
                },
               crossDomain: true,
               success: function (data, status, xhr) {
                   if (data) {

                       if (data.success == true) {
                           $(".submit").val("Success")
                           $(".submit").addClass(`successButton`)
                           setTimeout(() => {
                              redirect('/')
                           }, 1000)
                       }
                       if (data.success == false) {
                           $(".submit").val("Passwort festlegen")
                           $('.submit').prop('disabled', false);
                           $('.infoContainer').show()
                           $('.infoContainer .info').html(data.message)
                           $(".content").css("opacity", "1");

                           
                       }
                   }

               },
               error: function (jqXHR, textStatus, err) {
                   $(".content").css("opacity", "1");

                   $('.fileInput').show()
                   $('.infoContainer').show()
                   $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                   $(".submit").val("Passwort festlegen")
                   $('.submit').prop('disabled', false);
               }
           });


       } catch (error) {
           console.log(error)
           $(".content").css("opacity", "1");
           $('.infoContainer').show()
           $('.fileInput').show()
           $('.infoContainer .info').html("An error occerd whilst communication with our server.")
           $(".submit").val("Passwort festlegen")
           $('.submit').prop('disabled', false);
       }
   })
</script>