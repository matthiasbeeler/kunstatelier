<% var title =   "Profilbild" %>

<!DOCTYPE html>
<html>
  <%- include('../../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/user/account`)"})%>
      <div class="spacing13"></div>
        <form>
      <div class="fileInput standardInput submit grayShadowNoOffset" onclick="document.querySelector('#fileInput').click();">
        <img src="" alt="" class="filePreview" style="display: none;">

        <div class="placeholderText">
            Click to add new image
        </div>

        <input type="file" onchange="displayImage(this)" accept="image/*" id="fileInput" novalidate
            name="fileInput" required style="display: none; color: transparent; border: none;">
        <script>
            function displayImage(input) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();

                    reader.onload = function (e) {
                        $('.filePreview').attr('src', e.target.result);
                        $('.filePreview').show();
                        $('.fileInput .placeholderText').html('Click to retake');
                        $('.submitButton').removeClass('subtileButton')
                    }

                    reader.readAsDataURL(input.files[0]);
                }
            }
        </script>
    </div>
    <div class="spacing5"></div>
    <input type="submit" class="subtileButton submitButton button grayInnerShadowNoOffset submit" value="Profilbild updaten">
</form>
    </div>
    <%- include('../../modules/footer.ejs')%>

  </body>
</html>


<script>
    $("form").submit(function(e) {
       e.preventDefault();
       if(!$('#fileInput')[0].files[0]){
           $('.errorMessage').show()
       return $('.errorMessage .messageText').html(errorMessages[4])
   };
       if($('#fileInput')[0].files[0].size > 10097152){
       $('.errorMessage').show()
       return $('.errorMessage .messageText').html(errorMessages[3])
   };
       $('.errorMessageForm').hide()
       $(".submit").val("Loading...")
       $('.submit').prop('disabled', true);
       if($('#fileInput')[0].files[0].size > 10097152){
       $('.errorMessage').show()
       return $('.errorMessage .messageText').html(errorMessages[3])
   };
   $('.content').css('opacity', "0")
       try {
           var formData = new FormData();
           formData.append('changeElement', "image")
           formData.append('image', $('#fileInput')[0].files[0]);
           console.log(formData.get('image'))
           $.ajax({
               url: '/user/account/profileImage/',
               type: 'POST',
               processData: false,
               contentType: false,
               async: false,
               cache: false,
               data: formData,
               crossDomain: true,
               success: function (data, status, xhr) {
                   if (data) {

                       if (data.success == true) {
                           $(".submit").val("Success")
                           $(".submit").addClass(`successButton`)
                           setTimeout(() => {
                              redirect('/user/account')
                           }, 1000)
                       }
                       if (data.success == false) {
                           $(".submit").val("Profilbild updaten")
                           $('.submit').prop('disabled', false);
                           $('.errorMessage').show()
                           $('.errorMessage').html(data.message)
                           $(".content").css("opacity", "1");

                           
                       }
                   }

               },
               error: function (jqXHR, textStatus, err) {
                   $(".content").css("opacity", "1");

                   $('.fileInput').show()
                   $('.errorMessage').show()
                   $('.errorMessage').html("An error occerd whilst communication with our server.")

                   $(".submit").val("Profilbild updaten")
                   $('.submit').prop('disabled', false);
               }
           });


       } catch (error) {
           console.log(error)
           $(".content").css("opacity", "1");
           $('.errorMessage').show()
           $('.fileInput').show()
           $('.errorMessage').html("An error occerd whilst communication with our server.")
           $(".submit").val("Profilbild updaten")
           $('.submit').prop('disabled', false);
       }
   })
</script>