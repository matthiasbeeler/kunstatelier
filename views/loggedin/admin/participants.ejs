<% var title =   "Teilnehmerverwaltung" %>

<!DOCTYPE html>
<html>
  <%- include('../../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/admin`)"})%>
      <div class="spacing13"></div>
      <input type="text" id="searchInput" required name="input" onchange="$(this).css('border', '0.5px solid black');"
      oninvalid="$(this).css('border', '2px solid red');" placeholder="Name"
      class="standardInput" onkeyup="search()">
      <div class="spacing5"></div>
      <% for(var i = 0; i < participants.length; i++) { %>
        <div class="atelierContainer participantContainer <%if(participants[i].active == 0) { %> orangeShadowNoOffset <%}else{ %>grayShadowNoOffset<%}%> participant<%=participants[i].id%>" onclick="redirect('/admin/participants/<%=participants[i].id%>')">
            <div class="participantInfo">
    
            <div class="aterlierTitle participantName titleH3 titleNoMargin">
              <%=participants[i].firstName%> <%=participants[i].lastName%>

            </div>
            
    
              <div class="title titleH4 lightText titleNoMargin">
                <%=participants[i].email%>
              </div>
              <div class="title titleH4 lightText titleNoMargin">
                Klasse <%=participants[i].class%>
            </div>
        </div>
        <img class="arrow" src="/images/arrow.svg" alt="">
            
          </div>
          <div class="spacing5"></div>
      <% } %>

    </div>
    <%- include('../../modules/footer.ejs')%>

  </body>
</html>

<script>
     function search() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.querySelector(".content");
            tr = table.getElementsByClassName("atelierContainer");
            // Loop through all table rows, and hide those who don't match the search query
            for (i = 0; i < tr.length; i++) {
                td = tr[i].querySelector(".participantName");
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        
</script>