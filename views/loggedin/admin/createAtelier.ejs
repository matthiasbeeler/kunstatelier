<% var title =   "Atelier erstellen" %>

<!DOCTYPE html>
<html>
  <%- include('../../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/admin/`)"})%>
      <div class="spacing10"></div>
      <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
        <div class="titleH4 info">

        </div>
    </div>
    <div class="spacing5"></div>
      <form id="form">
        <input type="text" id="date" required name="date" onchange="$(this).css('border', '0.5px solid black');"
        oninvalid="$(this).css('border', '2px solid red');" placeholder="Datum (dd.mm.yyyy)" pattern="[0-9]{2}.[0-9]{2}.[0-9]{4}" 
        class="standardInput dateInputLeft">
        <input type="text" id="time" required name="time" onchange="$(this).css('border', '0.5px solid black');"
        oninvalid="$(this).css('border', '2px solid red');" placeholder="Uhrzeit" 
        class="standardInput timeInputRight">
        
        <div class="spacing5"></div>
        <input type="text" id="subject" name="subject" onchange="$(this).css('border', '0.5px solid black');"
        oninvalid="$(this).css('border', '2px solid red');" placeholder="Thema" 
        class="standardInput">
        <div class="spacing5"></div>
        <textarea name="furtherInformation" placeholder="Weitere Informationen" id="furtherInformation" cols="30" rows="2"></textarea>
        <div class="spacing5"></div>
        <input type="number" id="participantCapacity" name="participantCapacity" onchange="$(this).css('border', '0.5px solid black');"
        oninvalid="$(this).css('border', '2px solid red');" placeholder="Maximale Teilnehmerzahl" 
        class="standardInput">
        <div class="spacing5"></div>
        <select name="activeSelect" class="activeSelect" id="activation">
          <option value="" disabled selected hidden>Bitte Kurstyp wählen</option>
          <option value="1">Kursleitung vor Ort</option>
          <option value="0">Ohne Kursleitung vor Ort</option>
      </select>
        <div class="spacing5"></div>
      <input type="submit" class="submitButton button submit" value="Erstellen">

      </form>
    </div>
    <%- include('../../modules/footer.ejs')%>

  </body>
</html>

<script>
   
     //datepicker
  var el = document.getElementById("date");

el.onkeyup = function (evt) {
  if ((evt.keyCode >= 48 && evt.keyCode <= 57) || (evt.keyCode >= 96 &&
    evt.keyCode <= 105)) {
    evt = evt || window.event;

    var size = document.getElementById('date').value.length;

    if ((size == 2 && document.getElementById('date').value > 31) || (size == 5 && Number(document
      .getElementById('date').value.split('.')[1]) > 99) || (size >= 10 && Number(document.getElementById(
        'date').value.split('.')[2]) > 2030)) {

      return;
    }

    if ((size == 2 && document.getElementById('date').value < 32) || (size == 5 && Number(document
      .getElementById('date').value.split('.')[1]) < 99)) {
      document.getElementById('date').value += '.';
    }

  } else {
  }
}

var el = document.getElementById("time");

el.onkeyup = function (evt) {
  if ((evt.keyCode >= 48 && evt.keyCode <= 57) || (evt.keyCode >= 96 &&
    evt.keyCode <= 105)) {
    evt = evt || window.event;

    var size = document.getElementById('time').value.length;

    if ((size == 2 && document.getElementById('time').value > 24) || (size == 5 && Number(document
      .getElementById('time').value.split('.')[1]) > 60) || size > 5) {
        document.getElementById('time').value = "";
      return;
    }

    if ((size == 2 && document.getElementById('time').value < 25)) {
      document.getElementById('time').value += ':';
    }

  } else {
  }
}

$("form").submit(function (e) {
        e.preventDefault();
        $('.errorMessage').hide()
        $(".submit").val("Loading...")
        $('.submit').prop('disabled', true);
        const form = document.getElementById("form");
        try {
            $.ajax({
                url: '/admin/createAtelier',
                type: 'POST',
                processData: false,
               contentType: false,
               async: false,
               cache: false,
               data:  new FormData(form),
               crossDomain: true,
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                            $(".submit").addClass(`successButton`)
                            $(".submit").val("Success")
                            setTimeout(() => {
                                window.location = "/admin/"
                            }, 1000)
                        }
                        if (data.success == false) {
                            $('.infoContainer').show()
                            $('.infoContainer .info').html(data.message)
                            $(".submit").val("Erstellen")
                            $('.submit').prop('disabled', false);
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.infoContainer').show()
                    $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                    $(".submit").val("Erstellen")
                    $('.submit').prop('disabled', false);
                }
            });


        } catch (error) {
            console.log(error)
            $('.infoContainer').show()
            $('.infoContainer .info').html("An error occerd whilst communication with our server.")
            $(".submit").val("Erstellen")
            $('.submit').prop('disabled', false);
        }
    })
</script>