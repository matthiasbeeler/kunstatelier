<% var title =   "Hallo, "+data.firstName %>

<!DOCTYPE html>
<html>
  <%- include('../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: true, backLink: "redirect(`/`)"})%>
      <div class="accountIcon" onclick="redirect(`/user/account/`)">
        <img src="/images/accountIcon.svg" alt="">
    </div>
      <div class="spacing13"></div>
      <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
        <div class="titleH4 info">

        </div>
    </div>
      <% if(data.admin == true){%>
        <% if(inactives == true){%>

        <input type="submit" onclick="redirect('/admin/participants')"
                class="subtileButton submitButton orangeShadowNoOffset button submit" value="Es gibt blockierte Nutzer">
                <div class="spacing5"></div>
                <%}%>

        <div onclick="redirect('/admin')" class="smallSubmitText submitButton submitDiv">
          Atelier verwalten
        </div>
        <div class="spacing5"></div>
        <%}%>
      <div class="titleH4 placeholderColour">
       Nächste Ateliertage
      </div>
      <div class="spacing5"></div>
      <div class="atelierContent">
        <%
        function getDayName(dateStr, locale)
{
    var date = new Date(dateStr);
    return date.toLocaleDateString(locale, { weekday: 'long' });        
}
        %>
        <% if(ateliers.length > 0)  { %>

      <% for(var i = 0; i < ateliers.length; i++) { %>
        <div onclick="redirect('/user/atelier/<%=ateliers[i].id%>')" class="atelierContainer  <%if(JSON.stringify(ateliers[i].participantsList).includes(data.id)){%>greenShadowNoOffset<%}else{%>grayShadowNoOffset<%}%>">
          <div class="aterlierTitle titleH4 titleNoMargin">
            <%=getDayName(ateliers[i].date, "de-CH")%>, <%=ateliers[i].dateNew%> <%=ateliers[i].time%> Uhr
          </div>
          <div class="infoList">
            <li><%if(!ateliers[i].subject){%>Kein spezielles Themengebiet
              <%}else{%>
                Thema: <%=ateliers[i].subject%><%}%></li>
                <li><%if(!ateliers[i].guidance){%>Eine Kursleitung wird <strong>nicht</strong> vor Ort sein
                  <%}else{%>
                    Eine Kursleitung wird vor Ort sein<%}%></li>

                    <%if(ateliers[i].participantCapacity){%>
                      <li>Maximale Teilnehmerzahl: <%=ateliers[i].participantCapacity%></li>
                      <%}%>
          </div>
  
          <div class="furtherInformation">
            <div class="title titleH4 titleNoMargin">
              Weitere Informationen
            </div>
            <div class="information">
              <%=ateliers[i].furtherInformation%>
            </div>
          </div>
          <div class="signedUpParttakers signedUpParttakers<%=ateliers[i].id%> link">
            Eingetragene Teilnehmer: <%=ateliers[i].participants%>
          </div>
        <%if(!JSON.stringify(ateliers[i].participantsList).includes(data.id)){%>
          <%if(ateliers[i].participantCapacity == null | Number(ateliers[i].participants) < Number(ateliers[i].participantCapacity)){%>
            <div class="smallSubmitText submitButton submitDiv submit<%=ateliers[i].id%>" onclick="createEntry(<%=ateliers[i].id%>)">
            Eintragen
          </div>
          <div class="alreadySignedUp signedUp<%=ateliers[i].id%>" style="display: none;">
            <img src="/images/check.svg" alt="" class="check">
            <div class="titleH4 title">Du bist nun eingetragen </div>
          </div>
          <% }else {%>
            <div class="alreadySignedUp">
              <img src="/images/warningRound.svg" alt="" class="check">
              <div class="titleH4 title">Teilnehmerzahl erreicht </div>
            </div>
            <% }%>

          <% }else {%>
            <div class="alreadySignedUp">
              <img src="/images/check.svg" alt="" class="check">
              <div class="titleH4 title">Du bist bereits eingetragen </div>
            </div>
            <% } %>

        </div>
        <div class="spacing10"></div>
        <% } %>

      <% } else {%>
        <div class="titleH3 ">
          Momentan sind keine Ateliers aufgeschalten.
         </div>
      <% } %>

    </div>

      
    </div>
    <%- include('../modules/footer.ejs')%>

  </body>
</html>

<script>
  function createEntry(id) {
    $('.errorMessage').hide()
        $(".submit"+id).val("Loading...")
        $('.submit'+id).prop('disabled', true);
        try {
            $.ajax({
                url: '/user/createEntry',
                type: 'POST',
                
               cache: false,
               data: {
                   "atelierId": id
                },
                xhrFields: {
                    withCredentials: true
                },
                crossDomain: true,
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                            $(".submit"+id).hide()
                            $('.signedUpParttakers'+id).html("Eingetragene Teilnehmer: "+data.participants);
                            $(".signedUp"+id).show()
                        }
                        if (data.success == false) {
                          console.log(data)
                            $('.infoContainer').show()
                            $('.infoContainer .info').html(data.message)
                            $(".submit"+id).val("Eintragen")
                            $('.submit'+id).prop('disabled', false);
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.infoContainer').show()
                    $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                    $(".submit"+id).val("Eintragen")
                            $('.submit'+id).prop('disabled', false);
                }
            });


        } catch (error) {
            console.log(error)
            $('.infoContainer').show()
            $('.infoContainer .info').html("An error occerd whilst communication with our server.")
            $(".submit"+id).val("Eintragen")
                            $('.submit'+id).prop('disabled', false);
        }
  }
</script>