<% var title =   "Hallo "+data.firstName %>

<!DOCTYPE html>
<html>
  <%- include('../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: true, backLink: "redirect(`/`)"})%>
      <div class="accountIcon" onclick="redirect(`/user/account/`)">
        <img src="/images/accountIcon.svg" alt="">
    </div>
      <div class="spacing13"></div>
      <% if(data.admin == true){%>
        <div onclick="redirect('/admin')" class="smallSubmitText submitButton submitDiv">
          Atelier verwalten
        </div>
        <div class="spacing5"></div>
        <%}%>
      <div class="titleH4 placeholderColour">
       Nächste Ateliertage
      </div>
      <div class="spacing5"></div>
      <div class="atelierContent">
        <%
        function getDayName(dateStr, locale)
{
    var date = new Date(dateStr);
    return date.toLocaleDateString(locale, { weekday: 'long' });        
}
        %>
        <% if(ateliers.length > 0)  { %>

      <% for(var i = 0; i < ateliers.length; i++) { %>
        <div class="atelierContainer  <%if(JSON.stringify(ateliers[i].participantsList).includes(data.id)){%>greenShadowNoOffset<%}else{%>grayShadowNoOffset<%}%>">
          <div class="aterlierTitle titleH4 titleNoMargin">
            <%=getDayName(ateliers[i].date, "de-CH")%>, <%=ateliers[i].dateNew%> <%=ateliers[i].time%> Uhr
          </div>
          <div class="infoList">
            <li><%if(!ateliers[i].subject){%>Kein spezielles Themengebiet
              <%}else{%>
                Thema: <%=ateliers[i].subject%><%}%></li>
                <li><%if(!ateliers[i].nadja){%>Najda wird <strong>nicht</strong> vor Ort sein
                  <%}else{%>
                    Najda wird vor Ort sein<%}%></li>
          </div>
  
          <div class="furtherInformation">
            <div class="title titleH4 titleNoMargin">
              Weitere Informationen
            </div>
            <div class="information">
              <%=ateliers[i].furtherInformation%>
            </div>
          </div>
          <div class="signedUpParttakers link">
            Eingetragene Teilnehmer: <%=ateliers[i].participants%>
          </div>
        <%if(!JSON.stringify(ateliers[i].participantsList).includes(data.id)){%>
          <div class="smallSubmitText submitButton submitDiv">
            Eintragen
          </div>
          <% }else {%>
            <div class="alreadySignedUp">
              <img src="/images/check.svg" alt="" class="check">
              <div class="titleH4 title">Du bist bereits eingetragen </div>
            </div>
            <% } %>

        </div>
        <div class="spacing10"></div>
        <% } %>

      <% } else {%>
        <div class="titleH3 ">
          Momentan sind keine Ateliers aufgeschalten.
         </div>
      <% } %>

    </div>

      
    </div>
    <%- include('../modules/footer.ejs')%>

  </body>
</html>
