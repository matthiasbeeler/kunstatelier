<% var title =   "Atelier" %>

<!DOCTYPE html>
<html>
  <%- include('../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/user`)"})%>
      <div class="spacing13"></div>
      

            <div class="name titleH2">
                <%=atelier.dateNew%>, <%=atelier.time%> Uhr
            </div>
      
      <div class="spacing5"></div>
      <div class="textMargin">
      <div class="infoList">
        <li><%if(!atelier.subject){%>Kein spezielles Themengebiet
          <%}else{%>
            Thema: <%=atelier.subject%><%}%></li>
            <li><%if(!atelier.guidance){%>Eine Kursleitung wird <strong>nicht</strong> vor Ort sein
              <%}else{%>
                Eine Kursleitung wird vor Ort sein<%}%></li>

                <%if(atelier.participantCapacity){%>
                  <li>Maximale Teilnehmerzahl: <%=atelier.participantCapacity%></li>
                  <%}%>
      </div>

      <div class="furtherInformation">
        <div class="title titleH4 titleNoMargin">
          Weitere Informationen
        </div>
        <div class="information">
          <%=atelier.furtherInformation%>
        </div>
      </div>
      <div class="signedUpParttakers signedUpParttakers<%=atelier.id%>">
        Eingetragene Teilnehmer: <%=atelier.participants%>
      </div></div>
      
      
      <%if(!JSON.stringify(atelier.participantsList).includes(data.id)){%>
        <%if(atelier.participantCapacity == null | Number(atelier.participants) < Number(atelier.participantCapacity)){%>
            <div
            class="grayShadowNoOffset bottomFixedButton smallSubmitText submitButton submitDiv submit<%=atelier.id%>" onclick="createEntry(<%=atelier.id%>)">
            Eintragen
          </div>
          <div class="textMargin alreadySignedUp signedUp<%=atelier.id%>" style="display: none;">
            <img src="/images/check.svg" alt="" class="check">
            <div class="titleH4 title">Du bist nun eingetragen </div>
          </div>
          <% }else {%>
            <div class="textMargin alreadySignedUp">
              <img src="/images/warningRound.svg" alt="" class="check">
              <div class="titleH4 title">Teilnehmerzahl erreicht </div>
            </div>
            <% }%>
        
        <% }else {%>
          <div class="textMargin alreadySignedUp">
            <img src="/images/check.svg" alt="" class="check">
            <div class="titleH4 title">Du bist bereits eingetragen </div>
          </div>
          <div class="spacing10"></div>
<input type="submit" onclick="showOverlay()"
class="subtileButton submitButton grayShadowNoOffset button submit removeEntryButton" value="Abmelden">
<div class="spacing10"></div>
<div class="overlay" style="display: none;">
    <div class="spacing18">
    </div>
    <div class="spacing5">
    </div>
    <div class="overlayInner">

        <div class="infoContainer redInnerShadowNoOffset">
            <div class="titleH3 info">
                Möchtest Du Dich wirklich vom Atelier vom <%=atelier.dateNew%> um <%=atelier.time%> Uhr abmelden?
            </div>
        </div>
        <div class="spacing5">

        </div>
        <input type="submit" onclick="removeEntry(<%=atelier.id%>)"
class=" submitButton redShadowNoOffset button submit" value="Ja, abmelden">
    </div>
</div>
          <% } %>
     <div class="spacing5">
        
     </div>
     <div class="titleH4 placeholderColour">
        Eingetragene Teilnehmer
       </div>
       <div class="textMargin participantsContainerContainer">

     <% for(var i=0; i<accountsData.length; i++) {%>
        <div class="singleAtelierParticipantContainer">
            <div class="innerContainer">
                            <div class="profileImage"  style="background-image: url('/user/uploads/profileImages/<%-accountsData[i].id%>.webp');">
            </div>
            <div class="firstName">
                <%= accountsData[i].firstName %>
            </div>

        </div>

        </div>
     <% } %>

       </div>
    </div>
    <%- include('../modules/footer.ejs')%>

  </body>
</html>



<script>
    var backAction;
    function showOverlay() {
        $('.overlay').show();
        backAction = $('.backButton').attr('onclick');
        $('.backButton').attr('onclick', "hideOverlay()")
    }
    function hideOverlay() {
        $('.overlay').hide();
        $('.backButton').attr('onclick', backAction)
    }
    function createEntry(id) {
      $('.errorMessage').hide()
          $(".submit"+id).val("Loading...")
          $('.submit'+id).prop('disabled', true);
          try {
              $.ajax({
                  url: '/user/createEntry',
                  type: 'POST',
                  
                 cache: false,
                 data: {
                     "atelierId": id
                  },
                  xhrFields: {
                      withCredentials: true
                  },
                  crossDomain: true,
                  success: function (data, status, xhr) {
                      if (data) {
                          if (data.success == true) {
                              $(".submit"+id).hide()
                              $('.signedUpParttakers'+id).html("Eingetragene Teilnehmer: "+data.participants);
                              $(".signedUp"+id).show()
                          }
                          if (data.success == false) {
                            console.log(data)
                              $('.infoContainer').show()
                              $('.infoContainer .info').html(data.message)
                              $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
                          }
                      }
  
                  },
                  error: function (jqXHR, textStatus, err) {
                      $('.infoContainer').show()
                      $('.infoContainer .info').html("An error occerd whilst communication with our server.")
  
                      $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
                  }
              });
  
  
          } catch (error) {
              console.log(error)
              $('.infoContainer').show()
              $('.infoContainer .info').html("An error occerd whilst communication with our server.")
              $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
          }
    }
    function removeEntry(id) {
      $('.errorMessage').hide()
          $(".removeEntry"+id).val("Loading...")
          $('.removeEntry'+id).prop('disabled', true);
          try {
              $.ajax({
                  url: '/user/removeEntry',
                  type: 'POST',
                  
                 cache: false,
                 data: {
                     "atelierId": id
                  },
                  xhrFields: {
                      withCredentials: true
                  },
                  crossDomain: true,
                  success: function (data, status, xhr) {
                      if (data) {
                          if (data.success == true) {
                                hideOverlay();
                              $(".submit"+id).show()
                              $('.signedUpParttakers'+id).html("Eingetragene Teilnehmer: "+data.participants);
                              $(".alreadySignedUp, .removeEntryButton").hide()
                          }
                          if (data.success == false) {
                            console.log(data)
                              $('.infoContainer').show()
                              $('.infoContainer .info').html(data.message)
                              $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
                          }
                      }
  
                  },
                  error: function (jqXHR, textStatus, err) {
                      $('.infoContainer').show()
                      $('.infoContainer .info').html("An error occerd whilst communication with our server.")
  
                      $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
                  }
              });
  
  
          } catch (error) {
              console.log(error)
              $('.infoContainer').show()
              $('.infoContainer .info').html("An error occerd whilst communication with our server.")
              $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
          }
    }
  </script>