<% var title="Passwort vergessen" %>

  <!DOCTYPE html>
  <html>
  <%- include('./modules/head.ejs', {title: title})%>

    <body>
      <div class="content">
        <%- include('./modules/top.ejs', {title: title, noLogo: true, noBack: false,
          backLink: "redirect(`/user/account`)" })%>
          <div class="spacing13"></div>
          <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
            <div class="titleH4 info">

            </div>
          </div>
          <div class="infoContainer successContainer greenShadowNoOffset" style="display: none;">
            <div class="titleH4 info">

            </div>
          </div>
          <div class="spacing5"></div>
          <form id="form">
            <input type="email" id="email" required name="email" onchange="$(this).css('border', '0.5px solid black');"
              oninvalid=" $(this).css('border', '2px solid red');" placeholder="Deine E-Mail Adresse"
              class="standardInput">
            <div class="spacing5"></div>
            <input type="submit" class="submitButton button submit" value="E-Mail anfordern">
          </form>
      </div>
      <%- include('./modules/footer.ejs')%>

    </body>

  </html>


  <script>
    $("form").submit(function (e) {
      e.preventDefault();
      const form = document.getElementById("form");
      try {
        
        $.ajax({
          url: '/passwordForgottenEmail/',
          type: 'POST',
          processData: false,
          contentType: false,
          async: false,
          cache: false,
          data: new FormData(form),
          crossDomain: true,
          success: function (data, status, xhr) {
            if (data) {

              if (data.success == true) {
                $(".submit").val("Success")
                $(".submit").addClass(`successButton`)
                setTimeout(() => {
                  redirect('/')
                }, 1000)
              }
              if (data.success == false) {
                $(".submit").val("Passwort updaten")
                $('.submit').prop('disabled', false);
                $('.infoContainer.redInnerShadowNoOffset').show()
                $('.infoContainer.redInnerShadowNoOffset .info').html(data.message)
                $(".content").css("opacity", "1");


              }
            }

          },
          error: function (jqXHR, textStatus, err) {
            $(".content").css("opacity", "1");

            $('.fileInput').show()
            $('.infoContainer.redInnerShadowNoOffset').show()
            $('.infoContainer.redInnerShadowNoOffset .info').html("An error occerd whilst communication with our server.")

            $(".submit").val("Passwort updaten")
            $('.submit').prop('disabled', false);
          }
        });


      } catch (error) {
        console.log(error)
        $(".content").css("opacity", "1");
        $('.infoContainer.redInnerShadowNoOffset').show()
        $('.fileInput').show()
        $('.infoContainer.redInnerShadowNoOffset .info').html("An error occerd whilst communication with our server.")
        $(".submit").val("Passwort updaten")
        $('.submit').prop('disabled', false);
      }
    })
  </script>