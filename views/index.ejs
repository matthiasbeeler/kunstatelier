<% var title =   "Login" %>

<!DOCTYPE html>
<html>
  <%- include('./modules/head.ejs', {title: "Kunstatelier"})%>

  <body>
    <div class="content">
      <%- include('./modules/top.ejs', {title: title, noLogo:false, noBack: true, backLink: "redirect(`/`)"})%>
      <div class="spacing13"></div>
      <form>
        <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
            <div class="titleH4 info">

            </div>
        </div>
        <div class="spacing5"></div>

      <input type="email" id="input" required name="input" onchange="$(this).css('border', '0.5px solid black');"
      oninvalid="$(this).css('border', '2px solid red');" placeholder="E-Mail"
      class="standardInput">
      <div class="spacing5"></div>
  <input type="password" id="password" required name="password" onchange="$(this).css('border', '0.5px solid black');"
      oninvalid=" $(this).css('border', '2px solid red');" placeholder="Passwort"
      class="standardInput">
      <div class="spacing5"></div>
      <input type="submit" class="submitButton button grayInnerShadowNoOffset submit" value="Login">
      <div class="spacing10"></div>
      <div class="seperator"></div>
      <div class="spacing10">
      </div>
      <center>
      <a class="subtileLink" onclick="redirect('/passwordForgotten')">Passwort vergessen</a>
    </center>
</form>

      <div class="spacing5"></div>
      <input type="submit" onclick="redirect('/signup')" class="subtileButton submitButton button grayInnerShadowNoOffset submit" value="Account erstellen">
    </div>
    <%- include('./modules/footer.ejs')%>

  </body>
</html>

<script>
  $("form").submit(function (e) {
        e.preventDefault();
        $('.errorMessage').hide()
        $(".submit").val("Loading...")
        $('.submit').prop('disabled', true);
        try {
            $.ajax({
                url: '/login',
                type: 'POST',
                cache: false,
                data: {
                    "input": $('#input').val(),
                    "password": $('#password').val(),
                },
                xhrFields: {
                    withCredentials: true
                },
                crossDomain: true,
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                            $(".submit").addClass(`successButton`)
                            $(".submit").val("Success")
                            setTimeout(() => {
                                window.location = "/user"
                            }, 1000)
                        }
                        if (data.success == false) {
                            $('.infoContainer').show()
                            $('.infoContainer .info').html(data.message)
                            $(".submit").val("Login")
                            $('.submit').prop('disabled', false);
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.infoContainer').show()
                    $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                    $(".submit").val("Login")
                    $('.submit').prop('disabled', false);
                }
            });


        } catch (error) {
            $('.infoContainer').show()
            $('.infoContainer .info').html("An error occerd whilst communication with our server.")
            $(".submit").val("Login")
            $('.submit').prop('disabled', false);
        }
    })
</script>